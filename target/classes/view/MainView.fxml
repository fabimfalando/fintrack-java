<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles.css" prefHeight="720.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">

    <!-- BARRA LATERAL (SIDEBAR) -->
    <left>
        <VBox prefWidth="220.0" spacing="20.0" styleClass="sidebar">
            <padding>
                <Insets top="30.0" right="15.0" bottom="30.0" left="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="⚡ FinTrack" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #22c55e;" />
                </HBox>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20.0"/></padding>
                    <Button text="🏠  Dashboard" prefWidth="200.0" styleClass="sidebar-btn, sidebar-btn-active" />
                    <Button text="💳  Transações" prefWidth="200.0" styleClass="sidebar-btn" />
                    <Button text="⚙️  Configurações" prefWidth="200.0" styleClass="sidebar-btn" />
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- ÁREA PRINCIPAL -->
    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0" />
            </padding>
            <children>
                <Label text="FinTrack - Gestão de Finanças" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" />

                <!-- CARDS DE RESUMO FINANCEIRO -->
                <HBox spacing="15.0">
                    <children>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="5.0">
                            <children>
                                <Label text="Receitas" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
                                <Label fx:id="lblReceitas" text="R$ 0,00" style="-fx-text-fill: #22c55e; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            </children>
                        </VBox>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="5.0">
                            <children>
                                <Label text="Despesas" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
                                <Label fx:id="lblDespesas" text="R$ 0,00" style="-fx-text-fill: #ef4444; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            </children>
                        </VBox>
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="5.0">
                            <children>
                                <Label text="Saldo Total" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
                                <Label fx:id="lblSaldo" text="R$ 0,00" style="-fx-text-fill: #3b82f6; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- FORMULÁRIO DE CADASTRO -->
                <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card">
                    <children>
                        <TextField fx:id="txtDescricao" promptText="Descrição" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtValor" promptText="Valor (R$)" prefWidth="120.0" />
                        <ComboBox fx:id="cbTipo" promptText="Tipo" prefWidth="130.0" />
                        <DatePicker fx:id="dpData" promptText="Data" prefWidth="140.0" />
                        <Button text="Adicionar" onAction="#handleAdicionar" styleClass="btn-primary" />
                        <Button text="Remover" onAction="#handleRemover" styleClass="btn-danger" />
                    </children>
                </HBox>

                <!-- TABELA DE TRANSAÇÕES -->
                <VBox VBox.vgrow="ALWAYS" styleClass="card">
                    <children>
                        <Label text="Transações Registadas" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-padding: 0 0 10 0;" />
                        <TableView fx:id="tableTransacoes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="250.0" />
                                <TableColumn fx:id="colValor" text="Valor" prefWidth="130.0" />
                                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120.0" />
                                <TableColumn fx:id="colData" text="Data" prefWidth="130.0" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>